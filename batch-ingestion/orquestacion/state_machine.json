{
  "Comment": "Flujo mensual de BikeNexus: descarga CSV -> Spark batch (catalogo, viajes, Gold). ADR-05.",
  "StartAt": "DescargarYDescomprimirCSV",
  "States": {
    "DescargarYDescomprimirCSV": {
      "Type": "Task",
      "Comment": "Paso 1: la Lambda de carga descarga y descomprime el CSV.zip de viajes a S3 Landing (RF-02).",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${LambdaCargaBatchArn}",
        "Payload": { "modo": "viajes" }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 30,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Next": "ProcesarCatalogo"
    },

    "ProcesarCatalogo": {
      "Type": "Task",
      "Comment": "Paso 2: Spark procesa el catalogo (Bronze->Silver) ANTES que los viajes (RF-03).",
      "Resource": "arn:aws:states:::elasticmapreduce:addStep.sync",
      "Parameters": {
        "ClusterId": "${EmrClusterId}",
        "Step": {
          "Name": "batch-catalogo",
          "ActionOnFailure": "CONTINUE",
          "HadoopJarStep": {
            "Jar": "command-runner.jar",
            "Args": [
              "spark-submit",
              "--deploy-mode", "cluster",
              "--packages", "io.delta:delta-spark_2.12:3.1.0",
              "s3://${CodeBucket}/spark/batch_catalogo.py",
              "--landing-path", "s3://${DataBucket}/landing/catalogo",
              "--bronze-path", "s3://${DataBucket}/bronze/catalogo",
              "--silver-path", "s3://${DataBucket}/silver/catalogo"
            ]
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 60,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Next": "ProcesarViajes"
    },

    "ProcesarViajes": {
      "Type": "Task",
      "Comment": "Paso 3: Spark procesa los viajes (Bronze sin perdida -> Silver con reglas de calidad) (RF-02, RF-05).",
      "Resource": "arn:aws:states:::elasticmapreduce:addStep.sync",
      "Parameters": {
        "ClusterId": "${EmrClusterId}",
        "Step": {
          "Name": "batch-viajes",
          "ActionOnFailure": "CONTINUE",
          "HadoopJarStep": {
            "Jar": "command-runner.jar",
            "Args": [
              "spark-submit",
              "--deploy-mode", "cluster",
              "--packages", "io.delta:delta-spark_2.12:3.1.0",
              "s3://${CodeBucket}/spark/batch_viajes.py",
              "--landing-path", "s3://${DataBucket}/landing/viajes",
              "--bronze-path", "s3://${DataBucket}/bronze/viajes",
              "--silver-path", "s3://${DataBucket}/silver/viajes",
              "--cuarentena-path", "s3://${DataBucket}/cuarentena/viajes",
              "--catalogo-silver", "s3://${DataBucket}/silver/catalogo"
            ]
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 60,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "Next": "ConstruirGold"
    },

    "ConstruirGold": {
      "Type": "Task",
      "Comment": "Paso 4: Spark construye el star schema en Gold (RF-08).",
      "Resource": "arn:aws:states:::elasticmapreduce:addStep.sync",
      "Parameters": {
        "ClusterId": "${EmrClusterId}",
        "Step": {
          "Name": "batch-gold",
          "ActionOnFailure": "CONTINUE",
          "HadoopJarStep": {
            "Jar": "command-runner.jar",
            "Args": [
              "spark-submit",
              "--deploy-mode", "cluster",
              "--packages", "io.delta:delta-spark_2.12:3.1.0",
              "s3://${CodeBucket}/spark/batch_gold.py",
              "--viajes-silver", "s3://${DataBucket}/silver/viajes",
              "--catalogo-silver", "s3://${DataBucket}/silver/catalogo",
              "--gold-path", "s3://${DataBucket}/gold"
            ]
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["States.ALL"],
          "IntervalSeconds": 60,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ],
      "End": true
    }
  }
}
